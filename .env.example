# Get this from: Neon Console → your project → Connection string
# Make sure "Connection pooling" is ON (use the pooler URL shown in the dialog)
DATABASE_URL=postgresql://neondb_owner:your-password@your-host-pooler.neon.tech/neondb?sslmode=require

# Better Auth requires a secret for session signing
BETTER_AUTH_SECRET=your-secret-key-here-min-32-chars

# Email of the super admin account — used by /admin-login for password-only sign-in.
# Must match a row in the "user" table that has role='admin'.
SUPER_ADMIN_EMAIL=admin@example.com

# Optional: enables the "Continue with Google" button on /sign-in and /sign-up.
# Get these from Google Cloud Console → APIs & Services → Credentials → OAuth client ID.
# Authorized redirect URI must be: https://<your-production-domain>/api/auth/callback/google
# Leave unset to keep Google sign-in disabled (the button will just error if clicked).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

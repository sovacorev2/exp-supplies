# Get this from: Neon Console → your project → Connection string
# Make sure "Connection pooling" is ON (use the pooler URL shown in the dialog)
DATABASE_URL=postgresql://neondb_owner:your-password@your-host-pooler.neon.tech/neondb?sslmode=require

# Better Auth requires a secret for session signing
BETTER_AUTH_SECRET=your-secret-key-here-min-32-chars

# Email of the super admin account — used by /admin-login for password-only sign-in.
# Must match a row in the "user" table that has role='admin'.
SUPER_ADMIN_EMAIL=admin@example.com

# Optional: enables the "Continue with Google" button on /sign-in and /sign-up.
# Get these from Google Cloud Console → APIs & Services → Credentials → OAuth client ID.
# Authorized redirect URI must be: https://<your-production-domain>/api/auth/callback/google
# Leave unset to keep Google sign-in disabled (the button will just error if clicked).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: enables invite/reminder emails from the Invitees page.
# Get an API key from resend.com, and set RESEND_FROM_EMAIL to an address
# on a domain you've verified in Resend (e.g. forms@yourdomain.com).
# Until a domain is verified, Resend's sandbox mode only delivers to your
# own account email — real invitee addresses won't receive anything yet.
# Leave both unset to keep sending disabled (the Send button will show a
# clear "Email is not configured" error; nothing else breaks).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional: enables the "Include Smart Insights" report option on the
# Analytics page (executive summary, key insights, recommendations, written
# by Gemini). Comma-separated pool of Gemini API keys — if one is
# rate-limited, the next is tried automatically. Get free keys at
# https://aistudio.google.com/apikey. Note: free-tier keys allow Google to
# use submitted data to improve their products; use paid-tier keys instead
# if that's not acceptable for your data.
# Leave unset to keep the Smart Insights option disabled — the rest of the
# report (charts, CSV export) is unaffected either way.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.6-flash
